<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ERKOS Security - Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --bg: #0a0d12;
            --panel: #11151c;
            --panel2: #161b23;
            --border: #1e242d;
            --border2: #2b333f;
            --text: #e6ebf2;
            --muted: #8a94a3;
            --faint: #5a6472;
            --accent: #10b981;
            --accent2: #34d399;
            --red: #f0556a;
            --amber: #f5a524;
        }

        [data-theme="light"] {
            --bg: #eef0f3;
            --panel: #ffffff;
            --panel2: #f7f9fb;
            --border: #e3e6ea;
            --border2: #d3d8df;
            --text: #10151c;
            --muted: #5b6472;
            --faint: #98a1b0;
            --accent: #059669;
            --accent2: #10b981;
            --red: #e23744;
            --amber: #d97706;
        }

        @keyframes erkpulse { 0%,100%{opacity:1} 50%{opacity:.25} }
        @keyframes erkspin  { to{transform:rotate(360deg)} }
        @keyframes erkshake { 0%,100%{transform:translateX(0)} 20%{transform:translateX(-7px)} 40%{transform:translateX(6px)} 60%{transform:translateX(-4px)} 80%{transform:translateX(3px)} }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            background: var(--bg);
            color: var(--text);
            font-family: 'IBM Plex Sans', system-ui, sans-serif;
            font-size: 13px;
            -webkit-font-smoothing: antialiased;
        }

        /* Left brand panel */
        .brand-panel {
            flex: 1;
            min-width: 0;
            position: relative;
            overflow: hidden;
            background: var(--panel);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 40px 44px;
            background-image: radial-gradient(circle, var(--border2) 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .brand-panel::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(140deg, transparent 30%, var(--bg) 120%);
            pointer-events: none;
        }
        .brand-back {
            position: relative;
            z-index: 1;
            display: inline-flex;
            align-self: flex-start;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            font-weight: 600;
            color: var(--muted);
            text-decoration: none;
        }
        .brand-back-arrow {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-left: 1.5px solid currentColor;
            border-bottom: 1.5px solid currentColor;
            transform: rotate(45deg);
        }
        .brand-content {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            gap: 22px;
            max-width: 420px;
        }
        .brand-headline {
            margin: 0;
            font-size: 34px;
            line-height: 1.12;
            font-weight: 700;
            letter-spacing: -.02em;
        }
        .brand-desc {
            margin: 0;
            font-size: 13.5px;
            line-height: 1.55;
            color: var(--muted);
        }
        .live-console {
            margin-top: 6px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--bg);
            overflow: hidden;
        }
        .console-bar {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 9px 12px;
            border-bottom: 1px solid var(--border);
        }
        .dot-red   { width:9px; height:9px; border-radius:50%; background:var(--red); }
        .dot-amber { width:9px; height:9px; border-radius:50%; background:var(--amber); }
        .dot-green { width:9px; height:9px; border-radius:50%; background:var(--accent); }
        .console-url { margin-left: 6px; font-family:'IBM Plex Mono',monospace; font-size:10.5px; color:var(--faint); }
        .console-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--border); }
        .console-stat { background:var(--bg); padding:14px 12px; }
        .console-val { font-family:'IBM Plex Mono',monospace; font-size:22px; font-weight:600; color:var(--accent2); }
        .console-val.neutral { color:var(--text); }
        .console-lbl { font-size:9.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--faint); margin-top:3px; }
        .brand-footer { position:relative; z-index:1; font-family:'IBM Plex Mono',monospace; font-size:10.5px; color:var(--faint); }

        /* Right form panel */
        .form-panel {
            width: 480px;
            max-width: 46vw;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            position: relative;
            padding: 24px 24px 0;
        }
        .form-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .erkos-logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .erkos-icon { display: flex; align-items: center; justify-content: center; }
        .erkos-icon img { width: 44px; height: 44px; object-fit: contain; }
        [data-theme="dark"] .erkos-icon img { filter: brightness(0) invert(1); }
        .erkos-wordmark { display:flex; flex-direction:column; line-height:1.05; }
        .erkos-name { font-weight:700; letter-spacing:.16em; font-size:15px; }
        .erkos-sub  { font-size:8.5px; letter-spacing:.24em; color:var(--faint); font-weight:600; }
        .theme-btn {
            width:32px; height:32px;
            display:flex; align-items:center; justify-content:center;
            background:transparent; border:1px solid var(--border);
            border-radius:7px; cursor:pointer;
            color:var(--muted); font-size:13px;
        }
        .form-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
            max-width: 340px;
            width: 100%;
            margin: 0 auto;
            padding: 24px 0;
        }
        .form-heading { margin-bottom: 26px; }
        .form-eyebrow {
            font-size: 10px; letter-spacing:.16em; text-transform:uppercase;
            color:var(--accent2); font-weight:600;
            font-family:'IBM Plex Mono',monospace; margin-bottom:9px;
        }
        .form-title { margin:0 0 6px; font-size:24px; font-weight:700; letter-spacing:-.01em; }
        .form-subtitle { margin:0; font-size:13px; color:var(--muted); }

        .error-box {
            display: flex; align-items: center; gap: 9px;
            margin-bottom: 16px; padding: 10px 12px;
            border-radius: 8px;
            background: color-mix(in srgb, var(--red) 14%, transparent);
            border: 1px solid color-mix(in srgb, var(--red) 40%, transparent);
            color: var(--red); font-size: 12px; font-weight: 500;
        }
        .error-box.shake { animation: erkshake .42s ease; }
        .error-icon {
            flex-shrink: 0; width:16px; height:16px;
            border-radius:50%; border:1.5px solid currentColor;
            display:flex; align-items:center; justify-content:center;
            font-weight:700; font-size:11px;
        }

        .login-form { display:flex; flex-direction:column; gap:15px; }
        .field-label { display:flex; flex-direction:column; gap:7px; }
        .field-label-row {
            display:flex; align-items:center; justify-content:space-between;
        }
        .field-name {
            font-size:11px; letter-spacing:.06em; text-transform:uppercase;
            font-weight:600; color:var(--faint);
        }
        .forgot-link { font-size:11px; font-weight:600; color:var(--accent2); text-decoration:none; }
        .input-row {
            display:flex; align-items:center; gap:9px;
            padding: 0 12px; height:44px;
            background:var(--panel); border:1px solid var(--border);
            border-radius:9px; transition: border-color .15s;
        }
        .input-row:focus-within { border-color: var(--accent2); }
        .input-row.error { border-color: var(--red); }
        .input-row input {
            flex:1; background:transparent; border:none; outline:none;
            color:var(--text); font-family:inherit; font-size:13.5px;
        }
        .eye-btn {
            background:transparent; border:none; cursor:pointer;
            color:var(--faint); display:flex; padding:2px;
        }
        .remember-row {
            display:flex; align-items:center; gap:9px;
            cursor:pointer; user-select:none; margin-top:2px;
        }
        .remember-box {
            width:17px; height:17px; border-radius:5px;
            border:1px solid var(--border2); background:transparent;
            display:flex; align-items:center; justify-content:center;
            color:#06231a; font-size:11px; font-weight:700; flex-shrink:0;
            cursor:pointer; transition: background .15s, border-color .15s;
        }
        .remember-box.checked { background:var(--accent); border-color:var(--accent); }
        .remember-text { font-size:12.5px; color:var(--muted); }

        .submit-btn {
            margin-top:8px; height:46px;
            display:flex; align-items:center; justify-content:center; gap:9px;
            background:var(--accent); border:none; border-radius:9px;
            color:#06231a; font-size:14px; font-weight:700;
            font-family:inherit; cursor:pointer; letter-spacing:.01em;
            transition: opacity .15s;
        }
        .submit-btn:disabled { opacity:.7; cursor:not-allowed; }
        .submit-arrow {
            display:inline-block; width:7px; height:7px;
            border-top:1.6px solid #06231a; border-right:1.6px solid #06231a;
            transform:rotate(45deg);
        }
        .spinner {
            width:16px; height:16px;
            border:2px solid #06231a; border-top-color:transparent;
            border-radius:50%; animation: erkspin .7s linear infinite;
        }

        .security-note {
            margin-top:22px; padding-top:18px;
            border-top:1px solid var(--border);
            display:flex; align-items:center; gap:8px;
        }
        .security-dot { width:6px; height:6px; border-radius:50%; background:var(--accent); }
        .security-text { font-size:11px; color:var(--faint); }

        .form-footer {
            text-align:center; font-size:10.5px; color:var(--faint);
            padding:14px 0; font-family:'IBM Plex Mono',monospace;
        }

        /* Tablet */
        @media (max-width: 900px) {
            .brand-panel { display: none; }
            .form-panel  { width: 100%; max-width: 100%; }
        }

        /* Mobile */
        @media (max-width: 480px) {
            body { display: block; }

            .form-panel {
                width: 100%; max-width: 100%;
                padding: 20px 20px 0;
                min-height: 100dvh;
                display: flex; flex-direction: column;
            }

            .form-topbar { padding-bottom: 8px; }

            .form-body {
                padding: 20px 0;
                justify-content: flex-start;
                margin-top: 8px;
            }

            .form-heading { margin-bottom: 20px; }
            .form-title   { font-size: 22px; }

            /* Taller touch targets on inputs */
            .input-row { height: 50px; }

            /* Submit button full-width and taller */
            .submit-btn { height: 52px; font-size: 15px; margin-top: 4px; }

            /* Checkbox row spacing */
            .remember-row { margin-top: 4px; }
            .remember-text { font-size: 13px; }

            .security-note { margin-top: 18px; }
            .form-footer   { padding: 16px 0 20px; }
        }
    </style>
</head>
<body>

    <!-- Left brand panel -->
    <div class="brand-panel">
        <a href="/" class="brand-back">
            <span class="brand-back-arrow"></span>
            Back to home
        </a>

        <div class="brand-content">
            <h1 class="brand-headline">Parking intelligence,<br/>monitored around<br/>the clock.</h1>
            <p class="brand-desc">Real-time utilization, foot-traffic and infringement analytics across every property you manage — verified by AI, actioned by your team.</p>

            <div class="live-console">
                <div class="console-bar">
                    <span class="dot-red"></span>
                    <span class="dot-amber"></span>
                    <span class="dot-green"></span>
                    <span class="console-url">erkos://live-feed</span>
                </div>
                <div class="console-stats">
                    <div class="console-stat">
                        <div class="console-val">99%</div>
                        <div class="console-lbl">Accuracy</div>
                    </div>
                    <div class="console-stat">
                        <div class="console-val neutral">24h</div>
                        <div class="console-lbl">Monitoring</div>
                    </div>
                    <div class="console-stat">
                        <div class="console-val neutral">50+</div>
                        <div class="console-lbl">Properties</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="brand-footer">&copy; 2026 ERKOS &middot; Licensed enforcement partner</div>
    </div>

    <!-- Right form panel -->
    <div class="form-panel">
        <div class="form-topbar">
            <div class="erkos-logo">
                <div class="erkos-icon"><img src="/images/erkos.png" alt="ERKOS"></div>
                <div class="erkos-wordmark">
                    <span class="erkos-name">ERKOS</span>
                    <span class="erkos-sub">SECURITY&nbsp;DASHBOARD</span>
                </div>
            </div>
            <button class="theme-btn" id="themeToggle" title="Toggle theme">☀</button>
        </div>

        <div class="form-body">
            <div class="form-heading">
                <div class="form-eyebrow">Client Access</div>
                <h2 class="form-title">Welcome back</h2>
                <p class="form-subtitle">Sign in to your operations dashboard.</p>
            </div>

            <% if (error) { %>
            <div class="error-box" id="errorBox">
                <span class="error-icon">!</span>
                <%= error %>
            </div>
            <% } %>

            <form class="login-form" method="POST" action="/auth/login" id="loginForm">
                <label class="field-label">
                    <span class="field-name">Email</span>
                    <div class="input-row" id="emailRow">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--faint)" stroke-width="1.4">
                            <rect x="1.5" y="3" width="13" height="10" rx="1.5"></rect>
                            <path d="M2 4l6 4.5L14 4"></path>
                        </svg>
                        <input type="email" name="email" placeholder="you@property.com" autocomplete="username" required>
                    </div>
                </label>

                <label class="field-label">
                    <div class="field-label-row">
                        <span class="field-name">Password</span>
                        <a href="#" class="forgot-link">Forgot?</a>
                    </div>
                    <div class="input-row" id="passRow">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="var(--faint)" stroke-width="1.4">
                            <rect x="2.5" y="7" width="11" height="7" rx="1.5"></rect>
                            <path d="M5 7V5a3 3 0 0 1 6 0v2"></path>
                        </svg>
                        <input type="password" id="passwordInput" name="password" placeholder="••••••••" autocomplete="current-password" required>
                        <button type="button" class="eye-btn" id="eyeBtn" title="Show/hide password">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </button>
                    </div>
                </label>

                <div class="remember-row">
                    <div class="remember-box checked" id="rememberBox">&#10003;</div>
                    <span class="remember-text" id="rememberLabel">Keep me signed in for 24 hours</span>
                    <input type="checkbox" name="remember" id="rememberInput" checked style="display:none">
                </div>

                <button type="submit" class="submit-btn" id="submitBtn">
                    <span id="btnText">Access Dashboard</span>
                    <span class="submit-arrow" id="btnArrow"></span>
                    <div class="spinner" id="btnSpinner" style="display:none"></div>
                </button>
            </form>

            <div class="security-note">
                <span class="security-dot"></span>
                <span class="security-text">Encrypted session &middot; SOC 2 compliant infrastructure</span>
            </div>
        </div>

        <div class="form-footer">ERKOS Security Dashboard &copy; 2026</div>
    </div>

    <script>
        // Theme
        const html = document.documentElement;
        const saved = localStorage.getItem('erkos-theme') || 'dark';
        html.setAttribute('data-theme', saved);
        const themeBtn = document.getElementById('themeToggle');
        themeBtn.textContent = saved === 'dark' ? '☀' : '☾';
        themeBtn.addEventListener('click', () => {
            const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('erkos-theme', next);
            themeBtn.textContent = next === 'dark' ? '☀' : '☾';
        });

        // Password toggle
        const pwInput = document.getElementById('passwordInput');
        document.getElementById('eyeBtn').addEventListener('click', () => {
            const show = pwInput.type === 'password';
            pwInput.type = show ? 'text' : 'password';
            document.getElementById('eyeBtn').innerHTML = show
                ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>`
                : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
        });

        // Remember checkbox
        const rememberBox = document.getElementById('rememberBox');
        const rememberInput = document.getElementById('rememberInput');
        const rememberLabel = document.getElementById('rememberLabel');
        function updateRemember() {
            rememberBox.classList.toggle('checked', rememberInput.checked);
            rememberBox.textContent = rememberInput.checked ? '✓' : '';
        }
        rememberBox.addEventListener('click', () => { rememberInput.checked = !rememberInput.checked; updateRemember(); });
        rememberLabel.addEventListener('click', () => { rememberInput.checked = !rememberInput.checked; updateRemember(); });

        // Submit loading state
        document.getElementById('loginForm').addEventListener('submit', function() {
            const btn = document.getElementById('submitBtn');
            document.getElementById('btnText').textContent = 'Authenticating…';
            document.getElementById('btnArrow').style.display = 'none';
            document.getElementById('btnSpinner').style.display = 'block';
            btn.disabled = true;
        });
    </script>
</body>
</html>
